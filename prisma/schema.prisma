generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())
}

model SiteSetting {
  id               String   @id @default("default")
  storeName        String   @default("ATELIER THREADS")
  announcementBar  String   @default("Free worldwide shipping on orders over $100")
  heroTitle        String   @default("AUTUMN / WINTER COLLECTION")
  heroSubtitle     String   @default("Minimalist silhouettes crafted from organic heavyweight cotton.")
  heroImageUrl     String   @default("https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?w=1600")
  heroCtaText      String   @default("Shop New Arrivals")
  primaryColor     String   @default("#111827")
  contactEmail     String   @default("support@atelierthreads.com")
  updatedAt        DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Float
  imageUrl    String
  sizes       String[]
  colors      String[]
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  address       String
  totalAmount   Float
  status        String      @default("PENDING")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  size      String
  color     String
  price     Float
}